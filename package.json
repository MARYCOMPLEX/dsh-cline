{
  "name": "dsh-cline",
  "version": "1.4.5",
  "type": "module",
  "description": "Cline Pass upstream discovery, pinning, validation, and failover for DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cline",
    "cline-pass",
    "upstream",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARYCOMPLEX/dsh-cline.git"
  },
  "homepage": "https://github.com/MARYCOMPLEX/dsh-cline#readme",
  "bugs": {
    "url": "https://github.com/MARYCOMPLEX/dsh-cline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/core.test.js"
  },
  "license": "MIT"
}

